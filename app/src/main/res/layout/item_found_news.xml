    <TextView
        android:id="@+id/news_header"
        style="@style/FoundNewsTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_semi_small"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Latest opportunities in Coffee Business"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/news_image"
        app:layout_constraintTop_toTopOf="@id/news_image" />

    <TextView
        android:id="@+id/news_desc"
        style="@style/FoundNewsDesc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_semi_small"
        android:layout_marginTop="@dimen/spacing_extra_small"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Latest opportunities in Coffee Business"
        app:layout_constraintBottom_toTopOf="@id/news_author"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/news_image"
        app:layout_constraintTop_toBottomOf="@id/news_header" />

    <TextView
        android:id="@+id/news_author"
        style="@style/SmallGreySubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_semi_small"
        android:maxLines="1"
        android:text="Angel Westervelt"
        app:layout_constraintBottom_toBottomOf="@id/news_image"
        app:layout_constraintEnd_toStartOf="@id/date"
        app:layout_constraintStart_toEndOf="@id/news_image" />

    <TextView
        android:id="@+id/date"
        style="@style/SmallGreySubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_semi_small"
        android:maxLines="1"
        android:text="Jul 23, 2025"
        app:layout_constraintBottom_toBottomOf="@id/news_image"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>